file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/bad.hex" "48 89 f8 48 ff f0 c3")
file(WRITE "${WORK}/kept.cpp" "sentinel")
execute_process(COMMAND "${AOT}" "${WORK}/bad.hex" fixture_add "${WORK}/kept.cpp" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT code EQUAL 1)
    message(FATAL_ERROR "Invalid bytecode must fail: ${code} ${err}")
endif()
file(READ "${WORK}/kept.cpp" kept)
if(NOT kept STREQUAL "sentinel")
    message(FATAL_ERROR "Rejected input overwrote existing output")
endif()
execute_process(COMMAND "${AOT}" "${FIXTURE}" fixture_add "${WORK}/ok.cpp" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Valid fixture generation failed")
endif()
execute_process(COMMAND "${SMOKE}" RESULT_VARIABLE code OUTPUT_VARIABLE report)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Smoke CLI failed")
endif()
string(JSON checks GET "${report}" checks)
string(JSON failures GET "${report}" failures)
string(JSON game GET "${report}" game_execution)
if(checks LESS 40 OR NOT failures EQUAL 0 OR game)
    message(FATAL_ERROR "Incorrect smoke JSON: ${report}")
endif()
